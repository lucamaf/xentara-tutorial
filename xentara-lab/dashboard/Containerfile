# The tank station dashboard: static web page (HTML, CSS, JavaScript) served by nginx on UBI 10 minimal.
# Like the Xentara Inspector, it talks directly from the browser to Xentara's WebSocket interface (port 19670),
# on the host that the page was loaded from. The container itself never talks to Xentara.
#
#   podman build --format docker -t xentara-dashboard -f Containerfile .   (docker format keeps the HEALTHCHECK)
#   podman run -d --name xentara-dashboard -p 8091:8080 xentara-dashboard
#   -> http://<host>:8091   (add http://<host>:8091 to httpServer.CORS.allowedOrigins in Xentara's config.json)
FROM registry.access.redhat.com/ubi10/ubi-minimal

RUN microdnf install -y nginx && microdnf clean all

# remove the placeholder page and logos that the nginx package installs
RUN rm -rf /usr/share/nginx/html/*

COPY nginx.conf /etc/nginx/nginx.conf
COPY index.html dashboard.css cbor.js xentara.js mock.js dashboard.js /usr/share/nginx/html/

# group 0 owns what nginx writes to, so that the image also works with an arbitrary user ID (OpenShift)
RUN chmod -R a+rX /usr/share/nginx/html \
 && mkdir -p /var/lib/nginx /var/log/nginx \
 && chown -R 1001:0 /var/lib/nginx /var/log/nginx \
 && chmod -R g=u /var/lib/nginx /var/log/nginx

USER 1001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
